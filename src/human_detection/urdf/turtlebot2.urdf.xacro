<?xml version="1.0"?>
<!--
  TurtleBot2 (base Kobuki + bandejas hexagonales) con un lidar 360º encima.
  Modelo simplificado con primitivas para Gazebo: no necesita kobuki_description
  ni kobuki_gazebo_plugins (no están en apt para Noetic).
  Usa los mismos topics que el robot real:
    /mobile_base/commands/velocity (Twist)  /odom (Odometry)  /scan (LaserScan)
-->
<robot name="turtlebot2" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="base_radius" value="0.177" />
  <xacro:property name="wheel_radius" value="0.035" />
  <xacro:property name="wheel_separation" value="0.230" />
  <xacro:property name="lidar_height" value="0.43" />

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m * (3 * r * r + h * h) / 12}" ixy="0" ixz="0"
             iyy="${m * (3 * r * r + h * h) / 12}" iyz="0"
             izz="${m * r * r / 2}" />
  </xacro:macro>

  <!-- Base -->
  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.0102" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0595" />
      <geometry><cylinder radius="${base_radius}" length="0.0794" /></geometry>
      <material name="dark"><color rgba="0.2 0.2 0.2 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0595" />
      <geometry><cylinder radius="${base_radius}" length="0.0794" /></geometry>
    </collision>
    <!-- Bandejas: de 0.13 a 0.41 m (por debajo del plano del lidar) -->
    <collision>
      <origin xyz="-0.02 0 0.26" />
      <geometry><cylinder radius="0.16" length="0.28" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.01 0 0.0595" />
      <mass value="2.4" />
      <xacro:cylinder_inertia m="2.4" r="${base_radius}" h="0.0794" />
    </inertial>
  </link>

  <!-- Ruedas -->
  <xacro:macro name="wheel" params="side y">
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link" />
      <child link="wheel_${side}_link" />
      <origin xyz="0 ${y} 0.025" rpy="${-pi / 2} 0 0" />
      <axis xyz="0 0 1" />
    </joint>
    <link name="wheel_${side}_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="0.0206" /></geometry>
        <material name="black"><color rgba="0.05 0.05 0.05 1" /></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="0.0206" /></geometry>
      </collision>
      <inertial>
        <mass value="0.1" />
        <xacro:cylinder_inertia m="0.1" r="${wheel_radius}" h="0.0206" />
      </inertial>
    </link>
    <gazebo reference="wheel_${side}_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_separation / 2}" />
  <xacro:wheel side="right" y="${-wheel_separation / 2}" />

  <!-- Ruedas locas (sin rozamiento), 4 mm más altas para que el peso caiga en las ruedas motrices -->
  <xacro:macro name="caster" params="name x">
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="base_link" />
      <child link="caster_${name}_link" />
      <origin xyz="${x} 0 0.011" />
    </joint>
    <link name="caster_${name}_link">
      <collision>
        <geometry><sphere radius="0.017" /></geometry>
      </collision>
      <inertial>
        <mass value="0.01" />
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
    <gazebo reference="caster_${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="0.115" />
  <xacro:caster name="back" x="-0.135" />

  <!-- Bandejas y postes (solo visual, el lidar está por encima) -->
  <xacro:macro name="plate" params="name z">
    <joint name="plate_${name}_joint" type="fixed">
      <parent link="base_link" />
      <child link="plate_${name}_link" />
      <origin xyz="-0.02 0 ${z}" />
    </joint>
    <link name="plate_${name}_link">
      <visual>
        <geometry><cylinder radius="0.16" length="0.006" /></geometry>
        <material name="plate"><color rgba="0.15 0.15 0.15 1" /></material>
      </visual>
    </link>
  </xacro:macro>

  <xacro:plate name="bottom" z="0.13" />
  <xacro:plate name="middle" z="0.185" />
  <xacro:plate name="top" z="0.40" />

  <xacro:macro name="pole" params="name x y">
    <joint name="pole_${name}_joint" type="fixed">
      <parent link="base_link" />
      <child link="pole_${name}_link" />
      <origin xyz="${x} ${y} 0.265" />
    </joint>
    <link name="pole_${name}_link">
      <visual>
        <geometry><cylinder radius="0.006" length="0.27" /></geometry>
        <material name="metal"><color rgba="0.7 0.7 0.7 1" /></material>
      </visual>
    </link>
  </xacro:macro>

  <xacro:pole name="1" x="0.09" y="0.11" />
  <xacro:pole name="2" x="0.09" y="-0.11" />
  <xacro:pole name="3" x="-0.13" y="0.11" />
  <xacro:pole name="4" x="-0.13" y="-0.11" />

  <!-- Lidar 360º -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="laser_link" />
    <origin xyz="0 0 ${lidar_height}" />
  </joint>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04" /></geometry>
      <material name="black" />
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.04" /></geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <gazebo reference="laser_link">
    <sensor type="ray" name="lidar">
      <always_on>true</always_on>
      <update_rate>5.5</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_laser.so">
        <topicName>scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Tracción diferencial con los topics del Kobuki -->
  <gazebo>
    <plugin name="kobuki_controller" filename="libgazebo_ros_diff_drive.so">
      <commandTopic>mobile_base/commands/velocity</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <odometrySource>world</odometrySource>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelTF>false</publishWheelTF>
      <publishWheelJointState>true</publishWheelJointState>
      <leftJoint>wheel_left_joint</leftJoint>
      <rightJoint>wheel_right_joint</rightJoint>
      <wheelSeparation>${wheel_separation}</wheelSeparation>
      <wheelDiameter>${2 * wheel_radius}</wheelDiameter>
      <wheelTorque>5.0</wheelTorque>
      <wheelAcceleration>0</wheelAcceleration>
      <updateRate>50</updateRate>
      <legacyMode>false</legacyMode>
      <publishTf>1</publishTf>
      <rosDebugLevel>na</rosDebugLevel>
    </plugin>
  </gazebo>

</robot>
