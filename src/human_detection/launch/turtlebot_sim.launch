<launch>
    <!-- Gazebo con el TurtleBot3 en una habitación con una mesa y una persona -->
    <arg name="model" default="$(optenv TURTLEBOT3_MODEL burger)" />
    <arg name="gui" default="true" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find human_detection)/worlds/emotion_room.world" />
        <arg name="paused" value="false" />
        <arg name="use_sim_time" value="true" />
        <arg name="gui" value="$(arg gui)" />
    </include>

    <param name="robot_description"
           command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro" />

    <!-- El robot empieza mirando hacia la persona (x positiva) -->
    <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"
          args="-urdf -model turtlebot3_$(arg model) -x 0 -y 0 -z 0 -param robot_description" />

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
</launch>
